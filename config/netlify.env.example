# Reference only: set these in Netlify Project configuration > Environment variables.
# Never put secrets in src/. Two settings decide whether a value reaches the API:
#   Scopes  - must include Functions. Widening to Builds and Runtime as well is
#             harmless and avoids a value that exists but is invisible to the
#             function, which fails as an unexplained 503 at startup.
#   Context - use All, or the specific context you deploy (Production).
# Netlify binds these into a deploy when it is built, so a value added or changed
# after a deploy does nothing until the next one: redeploy after every change.
# Changing an existing variable's scopes may need it deleted and re-created.
GOCOACH_DEMO=false
GOCOACH_BOOTSTRAP_EMAIL=coach@example.com
GOCOACH_BOOTSTRAP_NAME=Carol Anthony
# Generate using: npm run --silent bootstrap:hash
GOCOACH_BOOTSTRAP_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GOCOACH_SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Optional: set only if using a custom canonical origin for Calendly callbacks.
# PUBLIC_ORIGIN=https://your-domain.example
# Optional: stable UUID for a separate practice / demo workspace.
# GOCOACH_WORKSPACE_ID=REPLACE_WITH_UUID
# Netlify provisions the database during the build (Neon extension + the SDK) and
# supplies it as NETLIFY_DB_URL / NETLIFY_DATABASE_URL; do not set those by hand.
# Netlify also applies netlify/database/migrations/ during the deploy, so do not run
# npm run db:migrate against it; that command is for self-managed PostgreSQL only.
# Do not add a browser DATABASE_URL or copy the production connection to previews.
# Calendly token and event links are entered in the coach's Settings page.
# Zoom Account ID, Client ID, Client Secret, and host email are entered in Settings.
# GOCOACH_SECRET_KEY also protects Zoom credentials.
