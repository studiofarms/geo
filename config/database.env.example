# Database tools read exported environment variables, not this file automatically.
# Use your deployment secret manager or a private local env file; never commit credentials.
# Supply DATABASE_URL OR the standard PG* variables below.
# DATABASE_URL=postgresql://gocoach_owner:REPLACE_ME@localhost:5432/gocoach
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gocoach
PGUSER=gocoach_owner
# Prefer a protected PGPASSFILE or your platform's credential injection.
# PGPASSWORD=REPLACE_ME
# Managed databases: use provider-specific CA settings and verify the certificate.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/absolute/path/to/provider-ca.pem
# Optional when psql is not on PATH:
# PG_BIN=/opt/homebrew/opt/postgresql@15/bin
# PSQL_BIN=/absolute/path/to/psql

# Only used by the optional local Docker Compose service:
# GOCOACH_POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
# GOCOACH_POSTGRES_PORT=5432
# GOCOACH_POSTGRES_IMAGE=postgres:15-alpine
